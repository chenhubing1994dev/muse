{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Muse",
  "version": "0.1.0",
  "identifier": "local.muse.command-center",
  "build": {
    "beforeDevCommand": "npm --prefix ../ui-prototype run dev -- --host 127.0.0.1",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm --prefix ../ui-prototype run build",
    "frontendDist": "../../ui-prototype/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "MUSE · 璇玑终端",
        "width": 1500,
        "height": 960,
        "minWidth": 960,
        "minHeight": 680,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost http://127.0.0.1:* https:; style-src 'self'; script-src 'self'; img-src 'self' asset: data:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../pyproject.toml": "pyproject.toml",
      "../../src/muse/": "src/muse/"
    },
    "linux": {
      "deb": {
        "depends": [
          "python3 (>= 3.11)"
        ]
      }
    }
  }
}