{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Muse",
  "version": "0.1.0",
  "identifier": "local.muse.command-center",
  "build": {
    "beforeDevCommand": "npm run dev -- --host 127.0.0.1",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../../ui-prototype/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "MUSE · 灵枢调度中心",
        "width": 1440,
        "height": 960,
        "minWidth": 960,
        "minHeight": 680,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://127.0.0.1:*; style-src 'self'; script-src 'self'; img-src 'self' asset: data:"
    }
  },
  "bundle": {
    "active": false
  }
}
