class _ProductHTMLValidator(HTMLParser):
    FORBIDDEN_TAGS = {"iframe", "object", "embed", "base", "form"}
    RESOURCE_ATTRIBUTES = {
        "src", "srcset", "action", "formaction", "poster", "data",
        "background", "manifest", "ping", "xlink:href",
    }

    def __init__(self) -> None:
        super().__init__(convert_charrefs=True)
        self.tags: set[str] = set()
        self.errors: list[str] = []
        self.scripts: list[tuple[str, str]] = []
        self.styles: list[str] = []
        self._current: str | None = None
        self._buffer: list[str] = []
        self.csp: str = ""

    def handle_starttag(self, tag: str, attrs: list[tuple[str, str | None]]) -> None:
        tag = tag.casefold()
        self.tags.add(tag)
        attr_map = {name.casefold(): value for name, value in attrs}
        if tag in self.FORBIDDEN_TAGS:
            self.errors.append("forbidden tag: " + tag)
        for name, value in attr_map.items():
            if name.startswith("on"):
                self.errors.append("event handler attribute: " + name)
            if name in self.RESOURCE_ATTRIBUTES and value:
                self.errors.append("resource loading attribute: " + name)
            if name == "style" and value:
                self.errors.append("inline style attribute is not permitted")
            if name == "href" and value and not value.startswith("#"):
                self.errors.append("non-local hyperlink")
        if tag == "meta" and attr_map.get("http-equiv", "").casefold() == "content-security-policy":
            self.csp = attr_map.get("content") or ""
        if tag in {"script", "style"}:
            if self._current is not None:
                self.errors.append("nested active content element")
            self._current = tag
            self._buffer = []
            if tag == "script":
                script_type = (attr_map.get("type") or "text/javascript").casefold()
                if attr_map.get("src"):
                    self.errors.append("external script is not permitted")
                self.scripts.append((script_type, ""))

    def handle_data(self, data: str) -> None:
        if self._current:
            self._buffer.append(data)

    def handle_endtag(self, tag: str) -> None:
        tag = tag.casefold()
        if self._current == tag:
            content = "".join(self._buffer)
            if tag == "script":
                script_type, _ = self.scripts[-1]
                self.scripts[-1] = (script_type, content)
            else:
                self.styles.append(content)
            self._current = None
            self._buffer = []

    def handle_startendtag(self, tag: str, attrs: list[tuple[str, str | None]]) -> None:
        self.handle_starttag(tag, attrs)
        self.handle_endtag(tag)


class LocalProductBuilder:
    """Build versioned, offline, interactive HTML products from initiative records."""

    BUILDER_VERSION = 5
    MAX_SEED_ITEMS = 40
    def __init__(self, workspace: str | Path) -> None:
        self.workspace = Path(workspace).resolve()
        if not self.workspace.is_dir():
            raise ProductBuildError("workspace must be an existing directory")

    @staticmethod
    def _sha256(data: bytes) -> str:
        return hashlib.sha256(data).hexdigest()

    @staticmethod
    def _safe_json(value: Any) -> str:
        return (
            json.dumps(value, ensure_ascii=False, separators=(",", ":"), allow_nan=False)
            .replace("&", r"\u0026").replace("<", r"\u003c").replace(">", r"\u003e")
            .replace("\u2028", r"\u2028").replace("\u2029", r"\u2029")
        )

    @staticmethod
    def _product_root(workspace: Path) -> Path:
        data_root = workspace / "data"
        product_root = data_root / "products"
        for candidate in (data_root, product_root):
            if candidate.is_symlink():
                raise ProductBuildError("product output path must not contain symlinks")
        if not product_root.resolve().is_relative_to(workspace):
            raise ProductBuildError("product output escapes the workspace")
        return product_root

    @staticmethod
    def _assert_no_symlink(path: Path, root: Path) -> None:
        try:
            relative = path.relative_to(root)
        except ValueError as exc:
            raise ProductBuildError("product path escapes output root") from exc
        current = root
        if current.is_symlink():
            raise ProductBuildError("product output root is a symlink")
        for part in relative.parts:
            current = current / part
            if current.is_symlink():
                raise ProductBuildError("product path contains a symlink")

    @staticmethod
    def _canonical_initiative(initiative: dict[str, Any]) -> dict[str, Any]:
        fields = (
            "id", "title", "kind", "creator_value", "concept", "first_step",
            "expected_output", "interest_signals", "inspiration_refs",
            "capability_gap", "priority", "autonomy_level",
        )
        return {key: initiative.get(key) for key in fields}

    @classmethod
    def _seed(cls, initiative: dict[str, Any]) -> dict[str, Any]:
        try:
            concept = json.loads(str(initiative.get("concept") or "{}"))
        except json.JSONDecodeError:
            concept = {}
        if not isinstance(concept, dict):
            concept = {}
        discoveries = concept.get("key_discoveries")
        if not isinstance(discoveries, dict):
            discoveries = {}
        hypotheses = discoveries.get("creator_inspired_hypotheses")
        if not isinstance(hypotheses, list):
            hypotheses = []
        clean_hypotheses = [
            str(item)[:4000] for item in hypotheses[:cls.MAX_SEED_ITEMS]
            if isinstance(item, (str, int, float)) and str(item).strip()
        ]
        uncertainties = discoveries.get("uncertainties")
        if not isinstance(uncertainties, list):
            uncertainties = []

        def clean_strings(value: Any, *, limit: int = cls.MAX_SEED_ITEMS, width: int = 2000) -> list[str]:
            if not isinstance(value, list):
                return []
            return [
                str(item)[:width] for item in value[:limit]
                if isinstance(item, (str, int, float)) and str(item).strip()
            ]

        sources = discoveries.get("sources")
        clean_sources = []
        if isinstance(sources, list):
            for item in sources[:cls.MAX_SEED_ITEMS]:
                if isinstance(item, dict):
                    parts = [
                        f"[{str(item.get('direction') or 'source_candidate')[:60]}]",
                        str(item.get("title") or "Untitled source")[:180],
                        str(item.get("url") or "")[:300],
                        f"review={str(item.get('review_state') or 'unreviewed')[:60]}",
                        f"quality={str(item.get('quality') or 'unassessed')[:60]}",
                        f"independence={str(item.get('independence') or 'unassessed')[:60]}",
                    ]
                    clean_sources.append(" · ".join(part for part in parts if part)[:2000])
                elif isinstance(item, (str, int, float)) and str(item).strip():
                    clean_sources.append(str(item)[:2000])

        counter_items = discoveries.get("counter_evidence")
        clean_counter_evidence = clean_strings(counter_items)
        clean_experiments = clean_strings(discoveries.get("testable_experiments"), width=3000)
        clean_domains = clean_strings(discoveries.get("research_domains"), width=300)
        clean_tags = clean_strings(discoveries.get("tags"), width=200)
        return {
            "id": initiative["id"],
            "title": str(initiative.get("title") or "Muse 灵感实验台")[:300],
            "creator_value": str(initiative.get("creator_value") or "")[:2000],
            "objective": str(concept.get("research_question") or "")[:4000],
            "design_goal": str(concept.get("design_goal") or initiative.get("first_step") or initiative.get("expected_output") or "")[:4000],
            "hypothesis_brief": str(concept.get("creator_hypothesis_summary") or "")[:4000],
            "epistemic_status": str(discoveries.get("epistemic_status") or "not_recorded")[:120],
            "evidence_review_state": str(discoveries.get("evidence_review_state") or "not_recorded")[:120],
            "hypotheses": clean_hypotheses,
            "uncertainties": clean_strings(uncertainties),
            "sources": clean_sources,
            "counter_evidence": clean_counter_evidence,
            "experiments": clean_experiments,
            "research_domains": clean_domains,
            "tags": clean_tags,
            "inspiration_refs": clean_strings(
                concept.get("inspiration_refs") if isinstance(concept.get("inspiration_refs"), list)
                else initiative.get("inspiration_refs") or []
            ),
        }
    @staticmethod
    def _content_readiness(seed: dict[str, Any]) -> dict[str, Any]:
        """Separate a technically valid package from a minimally testable product idea."""
        missing: list[str] = []
        if not str(seed.get("objective") or "").strip():
            missing.append("research_objective")
        if not (seed.get("hypotheses") or str(seed.get("hypothesis_brief") or "").strip()
                or str(seed.get("design_goal") or "").strip()):
            missing.append("testable_hypothesis_or_design_goal")
        if not seed.get("experiments"):
            missing.append("testable_experiment_or_acceptance_criteria")
        return {
            "status": "ready_for_human_review" if not missing else "incomplete",
            "ready_for_human_review": not missing,
            "missing_requirements": missing,
            "sources_state": "unreviewed" if seed.get("sources") else "not_collected",
            "counter_evidence_state": "unreviewed" if seed.get("counter_evidence") else "not_collected",
            "evidence_review_state": str(seed.get("evidence_review_state") or "not_recorded"),
        }

    @classmethod
    def _render_html(cls, seed: dict[str, Any]) -> str:
        seed_text = html.escape(cls._safe_json(seed), quote=False)
        script_hash = base64.b64encode(hashlib.sha256(APP_SCRIPT.encode("utf-8")).digest()).decode("ascii")
        style_hash = base64.b64encode(hashlib.sha256(APP_CSS.encode("utf-8")).digest()).decode("ascii")
        csp = (
            "default-src 'none'; "
            f"script-src 'sha256-{script_hash}'; "
            f"style-src 'sha256-{style_hash}'; "
            "connect-src 'none'; img-src 'none'; font-src 'none'; media-src 'none'; "
            "object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'"
        )
        title = html.escape(seed["title"], quote=True)
        objective = html.escape(seed["objective"], quote=True)
        return f"""<!doctype html>
