# Muse environment variables — EXAMPLE ONLY (placeholders, no real values).
# Muse reads these from the process environment (it does not auto-load a .env file).
# Set them in PowerShell, e.g.  $env:MUSE_SEARXNG_URL = "http://127.0.0.1:8888"
# Never commit real keys. .env / .env.* are git-ignored (only .env.example is tracked).
# Everything here is OPTIONAL: the core CLI, task queue, worker and smoke test need none of them.

# --- Cloud / provider credentials (optional; Muse is local-first and fails closed without them) ---
CHATANYWHERE_API_KEY=<your-chatanywhere-key>
CHATANYWHERE_MODEL=<model-name>
ANTHROPIC_API_KEY=<your-anthropic-key>
ANTHROPIC_AUTH_TOKEN=<your-anthropic-token>
OLLAMA_API_KEY=<your-ollama-key>
MUSE_RUFLO_PROVIDER=<provider-id>

# --- Web Portal (HTTPS portal login) ---
MUSE_WEB_PASSWORD=<choose-a-strong-password>

# --- Local services (loopback endpoints) ---
MUSE_SEARXNG_URL=http://127.0.0.1:8888
MUSE_COMFYUI_ENDPOINT=http://127.0.0.1:8188
MUSE_COMFYUI_MODELS_DIR=D:\path\to\ComfyUI\models
MUSE_REVIEWER_URL=http://127.0.0.1:1234/v1
MUSE_REVIEWER_MODEL=<local-model-id>
MUSE_GEMMA_ENABLED=0
MUSE_GEMMA_BACKEND=lmstudio
MUSE_GEMMA_LMSTUDIO_URL=http://127.0.0.1:1234/v1
MUSE_GEMMA_LMSTUDIO_MODEL=<local-model-id>
MUSE_GEMMA_MODEL_PATH=D:\path\to\model.gguf
MUSE_MINGLI_BASE_URL=http://127.0.0.1:1234/v1
MUSE_MINGLI_MODEL=<local-model-id>
MUSE_LIGHTPANDA_CDP_URL=ws://127.0.0.1:9222

# --- Feature switches / limits ---
MUSE_ENABLE_VIDEO_WORKER=0
MUSE_VIDEO_MAX_RUNTIME_SECONDS=3600
MUSE_MEMPALACE_ENABLED=0

# --- Mind loop (muse-mind); empty = deterministic mode without a model ---
MUSE_MIND_LLM_URL=http://127.0.0.1:1234/v1
MUSE_MIND_MODEL=<local-model-id>

# --- Local tool paths (override built-in Windows defaults) ---
MUSE_PYTHON314=C:\path\to\python314\python.exe
MUSE_AGENT_DESKTOP_EXE=D:\path\to\agent-desktop-win32-x64.exe
MUSE_RUFLO_NODE=C:\path\to\node.exe
MUSE_RUFLO_CLI=D:\path\to\ruflo\bin\ruflo.js
MUSE_CRAFT_ANYTHING_CLI=D:\path\to\craft-anything-cli.exe
MUSE_OBSIDIAN_CLI=D:\path\to\Obsidian.com
MUSE_OPEN_DESIGN_INSTALL_DIR=D:\path\to\Open Design
MUSE_CHIMERA_CLI=D:\path\to\chimera
MUSE_CHROME_BOOKMARKS_FILE=C:\Users\<you>\AppData\Local\Google\Chrome\User Data\Default\Bookmarks
MUSE_GPU_RESOURCE_DB=data\gpu\resources.sqlite3
